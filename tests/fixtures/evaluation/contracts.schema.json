{
  "$defs": {
    "AggregateV1": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "completed": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Completed",
          "type": "integer"
        },
        "mean_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Score"
        },
        "previous_mean_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Mean Score"
        }
      },
      "required": [
        "attempts",
        "completed"
      ],
      "title": "AggregateV1",
      "type": "object"
    },
    "AttemptEventV1": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "enum": [
            "started",
            "email_opened",
            "inspect_sender",
            "inspect_link",
            "report",
            "decline",
            "open_internal",
            "web_entered",
            "inspect_address",
            "leave",
            "confirm",
            "submit_synthetic",
            "completed",
            "abandoned"
          ],
          "title": "Action Id",
          "type": "string"
        },
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "component_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component Id"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "operation_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Operation Digest",
          "type": "string"
        },
        "operation_index": {
          "maximum": 2,
          "minimum": 0,
          "title": "Operation Index",
          "type": "integer"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "attempt-event-v1",
          "default": "attempt-event-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "surface": {
          "enum": [
            "email",
            "transition",
            "web",
            "system"
          ],
          "title": "Surface",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "attempt_id",
        "sequence",
        "surface",
        "action_id",
        "timestamp",
        "request_id",
        "operation_digest",
        "operation_index"
      ],
      "title": "AttemptEventV1",
      "type": "object"
    },
    "CompletedPathV1": {
      "additionalProperties": false,
      "properties": {
        "event_refs": {
          "items": {
            "$ref": "#/$defs/EvaluationEventReferenceV1"
          },
          "title": "Event Refs",
          "type": "array"
        },
        "kind": {
          "enum": [
            "SAFE_DECLINE",
            "WEB_VISITED"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "completed-path-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "event_refs"
      ],
      "title": "CompletedPathV1",
      "type": "object"
    },
    "CriterionEvaluationV1": {
      "additionalProperties": false,
      "properties": {
        "applicable": {
          "title": "Applicable",
          "type": "boolean"
        },
        "criterion": {
          "$ref": "#/$defs/EvaluationCriterionSnapshotV1"
        },
        "descriptive_transition": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransitionDecisionV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "MET",
            "NOT_MET",
            "NOT_APPLICABLE",
            "DESCRIPTIVE"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "position": {
          "maximum": 7,
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        },
        "schema_version": {
          "const": "criterion-evaluation-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "supporting_event_refs": {
          "items": {
            "$ref": "#/$defs/EvaluationEventReferenceV1"
          },
          "title": "Supporting Event Refs",
          "type": "array"
        },
        "weighted_contribution": {
          "anyOf": [
            {
              "maximum": 70000.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Weighted Contribution"
        }
      },
      "required": [
        "schema_version",
        "position",
        "criterion",
        "applicable",
        "outcome",
        "score",
        "weighted_contribution",
        "supporting_event_refs",
        "descriptive_transition"
      ],
      "title": "CriterionEvaluationV1",
      "type": "object"
    },
    "CriterionEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "applicable": {
          "title": "Applicable",
          "type": "boolean"
        },
        "condition_satisfied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Condition Satisfied"
        },
        "criterion": {
          "$ref": "#/$defs/EvaluationCriterionSnapshotV1"
        },
        "schema_version": {
          "const": "criterion-evidence-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "supporting_event_refs": {
          "items": {
            "$ref": "#/$defs/EvaluationEventReferenceV1"
          },
          "title": "Supporting Event Refs",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "criterion",
        "applicable",
        "condition_satisfied",
        "supporting_event_refs"
      ],
      "title": "CriterionEvidenceV1",
      "type": "object"
    },
    "CriticalObservationV1": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "enum": [
            "confirm",
            "submit_synthetic"
          ],
          "title": "Action Id",
          "type": "string"
        },
        "component_id": {
          "title": "Component Id",
          "type": "string"
        },
        "critical_policy_status": {
          "const": "NOT_CONFIGURED",
          "title": "Critical Policy Status",
          "type": "string"
        },
        "event_ref": {
          "$ref": "#/$defs/EvaluationEventReferenceV1"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "provenance": {
          "const": "authored_component",
          "title": "Provenance",
          "type": "string"
        },
        "schema_version": {
          "const": "critical-observation-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "surface": {
          "const": "web",
          "title": "Surface",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "event_ref",
        "surface",
        "action_id",
        "component_id",
        "provenance",
        "observed_at",
        "critical_policy_status"
      ],
      "title": "CriticalObservationV1",
      "type": "object"
    },
    "EvaluationCriterionSnapshotV1": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "enum": [
            "all_attempts",
            "web_visited",
            "web_not_visited"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "criterion_id": {
          "enum": [
            "email.sender",
            "email.link",
            "email.report",
            "transition.safe_decline",
            "transition.decision",
            "web.address",
            "web.leave",
            "web.report"
          ],
          "title": "Criterion Id",
          "type": "string"
        },
        "critical_action": {
          "const": null,
          "title": "Critical Action",
          "type": "null"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence_actions": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Actions",
          "type": "array"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "phase": {
          "enum": [
            "email",
            "transition",
            "web"
          ],
          "title": "Phase",
          "type": "string"
        },
        "schema_version": {
          "const": "evaluation-criterion-snapshot-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 10000.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Weight"
        }
      },
      "required": [
        "schema_version",
        "criterion_id",
        "label",
        "description",
        "phase",
        "weight",
        "applicability",
        "evidence_actions",
        "critical_action"
      ],
      "title": "EvaluationCriterionSnapshotV1",
      "type": "object"
    },
    "EvaluationErrorV1": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attempt Id"
        },
        "code": {
          "enum": [
            "ACCESS_DENIED",
            "ATTEMPT_NOT_COMPLETED",
            "UNSUPPORTED_VERSION",
            "INVALID_RUBRIC",
            "INVALID_EVIDENCE",
            "STORAGE_BUSY",
            "STORAGE_UNAVAILABLE",
            "SOURCE_UNAVAILABLE",
            "IMMUTABLE_SOURCE_INTEGRITY_ERROR",
            "STORED_EVALUATION_INTEGRITY_ERROR",
            "STORED_FEEDBACK_INTEGRITY_ERROR",
            "STORAGE_FAILURE"
          ],
          "title": "Code",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "integrity_reason": {
          "anyOf": [
            {
              "enum": [
                "IMMUTABLE_SOURCE_MISSING",
                "IMMUTABLE_SOURCE_INVALID",
                "RESULT_DIGEST_MISMATCH",
                "RESULT_BINDING_MISMATCH",
                "EVIDENCE_BINDING_MISMATCH",
                "CRITERION_DETAILS_INVALID",
                "ARITHMETIC_MISMATCH",
                "FEEDBACK_INTEGRITY_MISMATCH"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Integrity Reason"
        },
        "operation": {
          "enum": [
            "evaluate",
            "read",
            "feedback",
            "analytics_read"
          ],
          "title": "Operation",
          "type": "string"
        },
        "result_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result Id"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "const": "evaluation-error-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "code",
        "retryable",
        "correlation_id",
        "attempt_id",
        "result_id",
        "integrity_reason"
      ],
      "title": "EvaluationErrorV1",
      "type": "object"
    },
    "EvaluationEventReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "sequence"
      ],
      "title": "EvaluationEventReferenceV1",
      "type": "object"
    },
    "EvaluationEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "$ref": "#/$defs/ScenarioAttemptV1"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/CriterionEvidenceV1"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "critical_observations": {
          "items": {
            "$ref": "#/$defs/CriticalObservationV1"
          },
          "title": "Critical Observations",
          "type": "array"
        },
        "critical_policy_status": {
          "const": "NOT_CONFIGURED",
          "title": "Critical Policy Status",
          "type": "string"
        },
        "event_count": {
          "minimum": 1,
          "title": "Event Count",
          "type": "integer"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/AttemptEventV1"
          },
          "minItems": 1,
          "title": "Events",
          "type": "array"
        },
        "events_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Events Digest",
          "type": "string"
        },
        "evidence_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/CompletedPathV1"
        },
        "schema_version": {
          "const": "evaluation-evidence-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scoring_strategy": {
          "const": "cyberforge-weighted-actions-v1",
          "title": "Scoring Strategy",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/EvaluationSourceV1"
        },
        "terminal_sequence": {
          "minimum": 1,
          "title": "Terminal Sequence",
          "type": "integer"
        },
        "transition": {
          "$ref": "#/$defs/TransitionDecisionV1"
        }
      },
      "required": [
        "schema_version",
        "attempt",
        "source",
        "scoring_strategy",
        "events",
        "event_count",
        "terminal_sequence",
        "events_digest",
        "path",
        "transition",
        "criteria",
        "critical_policy_status",
        "critical_observations",
        "evidence_digest"
      ],
      "title": "EvaluationEvidenceV1",
      "type": "object"
    },
    "EvaluationResultV1": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "$ref": "#/$defs/ScenarioAttemptV1"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/CriterionEvaluationV1"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "critical_observations": {
          "items": {
            "$ref": "#/$defs/CriticalObservationV1"
          },
          "title": "Critical Observations",
          "type": "array"
        },
        "critical_policy_status": {
          "const": "NOT_CONFIGURED",
          "title": "Critical Policy Status",
          "type": "string"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "event_count": {
          "minimum": 1,
          "title": "Event Count",
          "type": "integer"
        },
        "events_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Events Digest",
          "type": "string"
        },
        "evidence_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/CompletedPathV1"
        },
        "reason_code": {
          "anyOf": [
            {
              "const": "NO_APPLICABLE_NUMERICAL_CRITERIA",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "result_id": {
          "format": "uuid",
          "title": "Result Id",
          "type": "string"
        },
        "schema_version": {
          "const": "evaluation-result-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "score_percent": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score Percent"
        },
        "scoring_strategy": {
          "const": "cyberforge-weighted-actions-v1",
          "title": "Scoring Strategy",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/EvaluationSourceV1"
        },
        "status": {
          "enum": [
            "SCORED",
            "UNSCORABLE"
          ],
          "title": "Status",
          "type": "string"
        },
        "terminal_sequence": {
          "minimum": 1,
          "title": "Terminal Sequence",
          "type": "integer"
        },
        "transition": {
          "$ref": "#/$defs/TransitionDecisionV1"
        },
        "weighted_denominator": {
          "anyOf": [
            {
              "maximum": 70000.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Weighted Denominator"
        },
        "weighted_numerator": {
          "anyOf": [
            {
              "maximum": 70000.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Weighted Numerator"
        }
      },
      "required": [
        "schema_version",
        "result_id",
        "attempt",
        "source",
        "scoring_strategy",
        "event_count",
        "terminal_sequence",
        "events_digest",
        "evidence_digest",
        "path",
        "transition",
        "criteria",
        "critical_policy_status",
        "critical_observations",
        "status",
        "reason_code",
        "weighted_numerator",
        "weighted_denominator",
        "score_percent",
        "evaluated_at",
        "result_digest"
      ],
      "title": "EvaluationResultV1",
      "type": "object"
    },
    "EvaluationSourceV1": {
      "additionalProperties": false,
      "properties": {
        "manifest_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "manifest_schema_version": {
          "const": "scenario-publication-v1",
          "title": "Manifest Schema Version",
          "type": "string"
        },
        "publication_id": {
          "minimum": 1,
          "title": "Publication Id",
          "type": "integer"
        },
        "registry_version": {
          "const": "criterion-registry-v1",
          "title": "Registry Version",
          "type": "string"
        },
        "rubric_id": {
          "title": "Rubric Id",
          "type": "string"
        },
        "rubric_schema_version": {
          "const": "rubric-definition-v1",
          "title": "Rubric Schema Version",
          "type": "string"
        },
        "rubric_semantics_version": {
          "const": "rubric-declarations-v1",
          "title": "Rubric Semantics Version",
          "type": "string"
        },
        "schema_version": {
          "const": "evaluation-source-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/ReviewedSourcesV1"
        },
        "version_id": {
          "minimum": 1,
          "title": "Version Id",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "publication_id",
        "version_id",
        "manifest_schema_version",
        "manifest_digest",
        "snapshot",
        "rubric_id",
        "rubric_schema_version",
        "registry_version",
        "rubric_semantics_version"
      ],
      "title": "EvaluationSourceV1",
      "type": "object"
    },
    "ExplanationV1": {
      "additionalProperties": false,
      "properties": {
        "aggregate": {
          "anyOf": [
            {
              "$ref": "#/$defs/AggregateV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision_maker": {
          "const": "instructor",
          "default": "instructor",
          "title": "Decision Maker",
          "type": "string"
        },
        "difficulty_suggestion": {
          "enum": [
            "keep",
            "instructor_review"
          ],
          "title": "Difficulty Suggestion",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "recommendations": {
          "items": {
            "type": "string"
          },
          "title": "Recommendations",
          "type": "array"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultFactsV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "explanation-v1",
          "default": "explanation-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_facts": {
          "items": {
            "$ref": "#/$defs/FactV1"
          },
          "title": "Selected Facts",
          "type": "array"
        }
      },
      "required": [
        "selected_facts",
        "recommendations",
        "limitations",
        "difficulty_suggestion"
      ],
      "title": "ExplanationV1",
      "type": "object"
    },
    "FactV1": {
      "additionalProperties": false,
      "description": "Trusted sanitized educational fact, not a raw event or learner record.",
      "properties": {
        "defensive_behavior": {
          "title": "Defensive Behavior",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "fact_id": {
          "title": "Fact Id",
