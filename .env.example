# Phase 4: звичайний запуск застосунку та offline тести ключів не потребують.
# Шлях БД задається аргументом --database; demo запускається явно через --init-demo.
# LLM load_config() явно читає .env з поточної директорії; process environment
# має пріоритет, навіть якщо значення порожнє. Interpolation вимкнено.
# Реальні секрети тільки у локальному .env; не копіювати в UI/артефакти/репозиторій.
GOOGLE_API_KEY=
GROQ_API_KEY=
# Рекомендована явна cloud-конфігурація; без цих полів default mock/mock-v1.
# Не копіюйте файл поверх existing .env із ключами; додайте лише потрібні поля.
CYBERFORGE_LLM_PROVIDER=groq
CYBERFORGE_LLM_MODEL=openai/gpt-oss-120b
CYBERFORGE_LLM_MAX_RETRIES=2
CYBERFORGE_LLM_FALLBACK=false
# Новий explicit backup config: до owner live success ОБИДВА flags false.
CYBERFORGE_LLM_BACKUP={"provider":"gemini","model":"gemini-4-hydrogen","enabled":false,"access_verified":false}
# Після підтвердженого owner live success: access_verified=true, enabled=true
# лише якщо потрібний automatic fallback. Модель не викликається при startup.
# CYBERFORGE_LLM_FALLBACK — deprecated Gemini->Groq compatibility flag;
# з BACKUP його не можна ставити true. Ніякого implicit rerouting.
# Gemini: hydrogen(low/medium/high/xhigh),3.8(low/medium/high),3.5Lite(minimal/low/medium/high).
# Hydrogen: temperature/top_p/top_k не передаються. Groq не підтримує minimal/xhigh.
# Параметри можна задати JSON (без реальних персональних даних):
# max_output_tokens omitted/null: provider default; exception: Groq GPT-OSS
# Email uses4096 unless explicitly overridden. No application maximum.
# CYBERFORGE_LLM_PARAMETERS={"temperature":0.2,"thinking":"low","timeout_seconds":30}
# Optional Email override; absent inherits shared optional max_output_tokens.
# CYBERFORGE_EMAIL_MAX_OUTPUT_TOKENS=16000
# Opt-in local provider/model caps; unspecified dimensions/keys have no cap.
# Explicit levels apply together. Token estimate: input/schema bytes + explicit
# output allowance; unknown provider-default output cannot be reserved.
# Це не квоти API account, не billing controls і не persistent accounting.
# CYBERFORGE_LLM_LIMITS={"groq":{"rpm":10,"rpd":100,"tpm":8000,"tpd":100000},"groq:openai/gpt-oss-120b":{"rpm":10,"rpd":100,"tpm":8000,"tpd":100000}}
