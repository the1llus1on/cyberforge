# Phase 4: звичайний запуск застосунку та offline тести ключів не потребують.
# Шлях БД задається аргументом --database; demo запускається явно через --init-demo.
# LLM load_config() явно читає .env з поточної директорії; process environment
# має пріоритет, навіть якщо значення порожнє. Interpolation вимкнено.
# Реальні секрети тільки у локальному .env; не копіювати в UI/артефакти/репозиторій.
GOOGLE_API_KEY=
GROQ_API_KEY=
CYBERFORGE_LLM_PROVIDER=mock
CYBERFORGE_LLM_MODEL=mock-v1
CYBERFORGE_LLM_MAX_RETRIES=2
CYBERFORGE_LLM_FALLBACK=false
# Для Gemini дозволено gemini-3.8-flash або gemini-3.5-flash-lite;
# для Groq — openai/gpt-oss-120b. Архітектуру погоджено в ADR-0004.
# Параметри можна задати JSON (без реальних персональних даних):
# CYBERFORGE_LLM_PARAMETERS={"temperature":0.2,"max_output_tokens":512,"thinking":"low","timeout_seconds":30}
# Локальні provider/model caps; обидва рівні застосовуються одночасно.
# Це не квоти API account, не billing controls і не persistent accounting.
# CYBERFORGE_LLM_LIMITS={"groq":{"rpm":10,"rpd":100,"tpm":8000,"tpd":100000},"groq:openai/gpt-oss-120b":{"rpm":10,"rpd":100,"tpm":8000,"tpd":100000}}
